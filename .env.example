# cp .env.example .env 후 change-me 값을 바꾼다. .env는 커밋하지 않는다.
POSTGRES_DB=scm
POSTGRES_USER=scm_app
POSTGRES_PASSWORD=change-me
SCM_RO_PASSWORD=change-me
APP_DB_URL=jdbc:postgresql://localhost:5432/scm
APP_DB_USER=scm_app
APP_DB_PASSWORD=change-me
SCM_RO_DB_URL=jdbc:postgresql://localhost:5432/scm
SCM_RO_DB_USER=scm_ro
SCM_RO_DB_PASSWORD=change-me
